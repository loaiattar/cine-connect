{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": [
            "ES2022"
        ],
        "skipLibCheck": true,
        "strict": true,
        "esModuleInterop": true,
        "noEmit": true
    },
    "ts-node": {
        "esm": true
    },
    "include": [
        "cine.ts"
    ],
    "references": [
        {
            "path": "./apps/frontend"
        },
        {
            "path": "./apps/backend"
        },
        {
            "path": "./packages/shared"
        }
    ]
}