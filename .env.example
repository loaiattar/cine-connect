# Docker Compose uses this file for variable substitution when you run:
#   docker compose up
# Copy to .env and fill in values. Do not commit .env (it is gitignored).
#
# For local dev (running backend without Docker), use apps/backend/.env instead;
# see apps/backend/.env.example.

# Required for Compose services `db` and `cine-db-test` (no defaults in docker-compose.yaml).
POSTGRES_PASSWORD=
POSTGRES_TEST_PASSWORD=

# Optional PostgreSQL overrides (defaults match docker-compose.yaml)
# POSTGRES_USER=admin
# POSTGRES_DB=cineconnect
# POSTGRES_TEST_USER=postgres
# POSTGRES_TEST_DB=cineconnect_test

# Required for backend when running via Docker (≥32 chars when NODE_ENV=production)
JWT_SECRET=
TMDB_API_KEY=

# --- Public URL of the SPA (must match the browser address: scheme, host, port) ---
FRONTEND_ORIGIN=http://localhost:8080
# Used in password reset email links (usually same as FRONTEND_ORIGIN)
FRONTEND_APP_URL=http://localhost:8080

# Optional: extra allowed CORS origins (comma-separated). FRONTEND_ORIGIN is always allowed when set.
# Example: CORS_ORIGINS=https://admin.example.com,https://staging.example.com
# CORS_ORIGINS=

# --- Optional: password reset emails ---
# Mailgun (if MAILGUN_API_KEY + MAILGUN_DOMAIN are set, Mailgun is used instead of SMTP)
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# MAILGUN_URL=https://api.eu.mailgun.net/
# MAILGUN_FROM=
# SMTP (used when Mailgun is not configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Frontend Docker image (Vite) — variables are baked in at `docker compose build frontend` ---
#
# Local / cross-origin API (browser calls backend host directly):
# VITE_API_BASE_URL=http://localhost:3000
#
# Same-origin / VPS (browser calls /api on the SPA host; nginx in the image proxies to backend):
# VITE_SAME_ORIGIN_API=true
# VITE_API_BASE_URL=
# NGINX_API_UPSTREAM=http://backend:3000
VITE_API_BASE_URL=http://localhost:3000

# Optional: product name shown in the built SPA (default in compose: CinéConnect)
VITE_APP_NAME=CinéConnect

# Optional: TMDB image CDN base (default in compose matches Vite default)
# VITE_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
