# Docker Compose uses this file for variable substitution when you run:
#   docker compose up
# Copy to .env and fill in values. Do not commit .env (it is gitignored).
#
# For local dev (running backend without Docker), use apps/backend/.env instead;
# see apps/backend/.env.example.

# Required for Compose services `db` and `cine-db-test` (no defaults in docker-compose.yaml).
POSTGRES_PASSWORD=
POSTGRES_TEST_PASSWORD=

# Optional PostgreSQL overrides (defaults match docker-compose.yaml)
# POSTGRES_USER=admin
# POSTGRES_DB=cineconnect
# POSTGRES_TEST_USER=postgres
# POSTGRES_TEST_DB=cineconnect_test

# Required for backend when running via Docker (≥32 chars when NODE_ENV=production)
JWT_SECRET=
TMDB_API_KEY=

# Optional
FRONTEND_ORIGIN=http://localhost:8080
# Used in password reset email links
FRONTEND_APP_URL=http://localhost:8080
# CORS_ORIGINS=

# SMTP provider for transactional emails (password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Frontend Docker image (Vite) — used at **build** time when you `docker compose build frontend`.
# The browser loads the SPA from this origin and calls the API here (must be reachable from the user’s machine).
VITE_API_BASE_URL=http://localhost:3000
# VITE_APP_NAME=CinéConnect
# VITE_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
