PORT=3000
EXTERNAL_API_KEY=
EXTERNAL_API_URL=https://api.themoviedb.org/3
DATABASE_URL=

# Required in production (and when NODE_ENV is not "test"). Do not use the test default in production.
JWT_SECRET=

# CORS: optional. When set, only these origins are allowed. When unset in production, no origin is allowed.
# Use FRONTEND_ORIGIN for a single URL or CORS_ORIGINS for a comma-separated list (e.g. https://app.example.com,https://www.example.com).
FRONTEND_ORIGIN=
# CORS_ORIGINS=