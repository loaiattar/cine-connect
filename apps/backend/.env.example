# Use this file when running the backend locally (pnpm dev / node). Not used when running via Docker.
# For Docker: set JWT_SECRET and TMDB_API_KEY in the repo root .env (see root .env.example); Compose injects them.

# Server
PORT=3000

# Required. PostgreSQL connection string.
# When DB runs in Docker (docker compose up db): use localhost and the exposed port (see docker-compose.yaml).
# Example when DB is started with docker compose (use the same POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB as root .env):
# DATABASE_URL=postgres://admin:YOUR_POSTGRES_PASSWORD@localhost:5432/cineconnect
DATABASE_URL=

# Required when NODE_ENV is not "test". In production use a strong secret; do not use the test default.
JWT_SECRET=

# TMDB API key for movie/search routes (https://www.themoviedb.org/settings/api).
# Required in production. In local dev, the server starts without it but those routes fail until set.
TMDB_API_KEY=

# CORS: optional. When set, only these origins are allowed. When unset in production, no origin is allowed.
# FRONTEND_ORIGIN for a single URL, or CORS_ORIGINS for a comma-separated list.
FRONTEND_ORIGIN=
# CORS_ORIGINS=

# Password reset / transactional email
# Used to build reset links in email body.
FRONTEND_APP_URL=http://localhost:8080
# SMTP provider configuration (example: Mailtrap, SendGrid SMTP relay, SES SMTP, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=