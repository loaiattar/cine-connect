# --- Local dev (recommended): same-origin + Vite proxy ---
# Leave empty so the app calls `/api/...` on the dev server; `vite.config.ts` proxies `/api` and
# `/socket.io` to the backend (see `VITE_API_PROXY_TARGET`). Cookies stay first-party (SameSite works).
# VITE_API_BASE_URL=
# VITE_API_PROXY_TARGET=http://localhost:3000

# --- Alternative dev: cross-origin API (no proxy) ---
# Browser sends credentialed requests to another origin; you must allow your Vite origin in backend CORS.
# Avatar URLs (`/uploads/...`) are also resolved against this origin — keep it in sync with the backend
# that stores files (do not rely on VITE_API_PROXY_TARGET for media in this mode).
# VITE_API_BASE_URL=http://localhost:3000

# --- Production: full API origin (HTTPS); cookies use Secure in NODE_ENV=production on the API ---
# Required for `pnpm build` / `vite build` (no hardcoded fallback). Use .env.production or export.
# VITE_API_BASE_URL=https://api.yourdomain.com

# --- Production Docker (nginx image): same-origin API (recommended when SPA and API are different public hosts) ---
# Build with VITE_SAME_ORIGIN_API=true and empty VITE_API_BASE_URL; pass NGINX_API_UPSTREAM to the Dockerfile
# (backend URL reachable from nginx, e.g. https://backend-xxx.run.app or http://backend:3000 in Compose).
# VITE_SAME_ORIGIN_API=true
# VITE_API_BASE_URL=

VITE_APP_NAME=CinéConnect
# Optional TMDB CDN base (defaults in code if omitted)
# VITE_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
