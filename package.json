{
  "name": "cine-connect",
  "version": "1.0.0",
  "type": "module",
  "description": "CinéConnect Monorepo - Movie Platform",
  "main": "index.js",
  "scripts": {
    "gg": "tsx cine.ts gg",
    "gt": "tsx cine.ts gt",
    "cb": "tsx cine.ts cb",
    "gac": "tsx cine.ts gac",
    "gp": "tsx cine.ts gp",
    "db": "tsx cine.ts db",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "pipeline": "turbo run build test lint",
    "clean:ts-cache": "node scripts/clear-ts-cache.cjs",
    "predev": "node scripts/clear-ts-cache.cjs",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "cine": "tsx cine.ts",
    "docker:up": "docker compose up -d --build",
    "docker:up:quick": "docker compose up -d",
    "docker:backend:rebuild": "docker compose build backend && docker compose up -d backend"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "overrides": {
      "minimatch@3.1.2": "3.1.4",
      "minimatch@9.0.5": "9.0.7",
      "minimatch@10.2.0": "10.2.3",
      "rollup@4.55.1": "4.59.0",
      "@hono/node-server@1.19.9": "1.19.10",
      "hono@4.11.9": "4.12.4",
      "esbuild@0.18.20": "0.25.0",
      "ajv@6.12.6": "6.14.0",
      "diff@4.0.2": "4.0.4",
      "qs@6.14.1": "6.14.2"
    }
  },
  "devDependencies": {
    "@clack/prompts": "^0.11.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.10",
    "picocolors": "^1.1.1",
    "tsx": "^4.19.2",
    "turbo": "^2.8.10",
    "typescript": "^5.7.2"
  }
}